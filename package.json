{
  "name": "info-collect",
  "version": "1.0.0",
  "description": "信息批量获取工具",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"cd client && vite\"",
    "build": "cd client && vite build && cd .. && rm -f dist.zip && zip -r dist.zip dist/",
    "start": "node server/index.js",
    "preview": "cd client && vite preview",
    "deploy": "npm run build && pm2 start ecosystem.config.js",
    "restart": "pm2 restart info-collect"
  },
  "dependencies": {
    "express": "^4.18.2",
    "vue": "^3.4.0",
    "element-plus": "^2.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.0",
    "sass": "^1.80.0",
    "vite": "^5.4.0"
  }
}
